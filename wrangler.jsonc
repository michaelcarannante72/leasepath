{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leasepath",
  // Pin to a date you have tested against. Bump it on purpose after running `wrangler dev` and the tests,
  // not on every deploy. See https://developers.cloudflare.com/workers/configuration/compatibility-dates/
  "compatibility_date": "2026-10-08",
  "main": "./worker/index.js",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // The app routes with the URL hash (#/steps), so only "/" is an app page. /privacy, /terms, and
    // /search/* are rendered by the Worker. Any other path is a real 404 (public/404.html) instead of the app shell,
    // so /.well-known/*, /robots.txt, and missing images or scripts no longer return 200 HTML.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/privacy", "/privacy/", "/terms", "/terms/", "/after-you-find", "/after-you-find/", "/steps", "/steps/", "/resources", "/resources/", "/plan", "/plan/", "/blog", "/blog/", "/rent-share", "/rent-share/", "/rent-calculator", "/rent-calculator/", "/search", "/search/*"]
  },
  "routes": [
    { "pattern": "leasepath.app", "custom_domain": true },
    { "pattern": "www.leasepath.app", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USAGE_METER", "class_name": "UsageMeter" },
      { "name": "ACCOUNT_BOOK", "class_name": "AccountBook" }
    ]
  },
  // Per-IP limit for Ruby's chat (POST /api/guide), checked in worker/chatGuard.js before Turnstile and the model.
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "migrations": [
    { "tag": "v1-usage-meter", "new_sqlite_classes": ["UsageMeter"] },
    { "tag": "v2-account-book", "new_sqlite_classes": ["AccountBook"] }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
