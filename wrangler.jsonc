{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leasepath",
  // Pin to a date you have tested against. Bump it on purpose after running `wrangler dev` and the tests,
  // not on every deploy. See https://developers.cloudflare.com/workers/configuration/compatibility-dates/
  "compatibility_date": "2026-10-08",
  "main": "./worker/index.js",
  "workers_dev": false,
  "preview_urls": false,
  // The coming-soon switch (worker/pause.js). "on" — or any value that is not one of
  // 0/false/off/no/live/open — serves the placeholder and refuses the API. To bring the
  // site back, set this to "0" and redeploy; nothing else needs to change.
  "vars": { "SITE_PAUSED": "0" },
  "assets": {
    "directory": "./dist",
    // Named so worker/index.js can hand a request straight back to the built file.
    // Only "/", /robots.txt and /sitemap.xml are routed through the Worker (see
    // run_worker_first below), and with the site live each one is returned here
    // unchanged — the app shell, the real robots.txt, the real sitemap.
    "binding": "ASSETS",
    // The app routes with the URL hash (#/steps), so only "/" is an app page. /privacy, /terms, and
    // /search/* are rendered by the Worker. Any other path is a real 404 (public/404.html) instead of the app shell,
    // so /.well-known/*, /robots.txt, and missing images or scripts no longer return 200 HTML.
    "not_found_handling": "404-page",
    // "/" is here only for the coming-soon switch (worker/pause.js). With the site live the
    // Worker hands "/" straight to the built app shell, so this costs one hop and nothing else.
    "run_worker_first": ["/", "/robots.txt", "/sitemap.xml", "/api/*", "/privacy", "/privacy/", "/terms", "/terms/", "/after-you-find", "/after-you-find/", "/steps", "/steps/", "/resources", "/resources/", "/plan", "/plan/", "/blog", "/blog/", "/search", "/search/*", "/list-unit", "/list-unit/", "/listings-admin", "/listings-admin/", "/edit-listing", "/edit-listing/", "/voucher-ready", "/voucher-ready/", "/housing-connect", "/housing-connect/", "/sponsor", "/sponsor/", "/listing-check", "/listing-check/", "/docs-tracker", "/docs-tracker/", "/guides", "/guides/", "/partners", "/partners/", "/quiz", "/quiz/", "/start", "/start/", "/rent-share", "/rent-share/", "/rent-calculator", "/rent-calculator/", "/roadmap", "/roadmap/", "/shelter-roadmap", "/shelter-roadmap/", "/after-movein", "/after-movein/", "/tenant-rights", "/tenant-rights/", "/utility-help", "/utility-help/", "/heap", "/heap/", "/viewing-checklist", "/viewing-checklist/", "/viewing", "/viewing/", "/waitlist", "/waitlist/", "/waitlist-tracker", "/waitlist-tracker/", "/youth", "/youth/", "/youth-lgbtq", "/youth-lgbtq/", "/install", "/install/", "/share", "/share/", "/install-and-share", "/install-and-share/", "/caseworker-pack", "/caseworker-pack/", "/inspection-prep", "/inspection-prep/", "/scam-alerts", "/scam-alerts/", "/moving-help", "/moving-help/", "/know-your-rights", "/know-your-rights/", "/landlord-welcome", "/landlord-welcome/", "/match-alerts", "/match-alerts/", "/income-check", "/income-check/", "/income-prescreen", "/income-prescreen/", "/borough-guides", "/borough-guides/", "/leasebot", "/leasebot/"]
  },
  "routes": [
    { "pattern": "leasepath.app", "custom_domain": true },
    { "pattern": "www.leasepath.app", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USAGE_METER", "class_name": "UsageMeter" },
      { "name": "ACCOUNT_BOOK", "class_name": "AccountBook" }
    ]
  },
  // Per-IP limit for Ruby's chat (POST /api/guide), checked in worker/chatGuard.js before Turnstile and the model.
  "kv_namespaces": [
    {
      "binding": "LISTINGS_KV",
      "id": "2140cf57fe764bb49ec36f4ebf895e64",
      "preview_id": "63310720ac3a43beb124bbc8db5b0406"
    }
  ],
  // Per-IP limit for landlord listing submissions (POST /api/listings).
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LISTINGS_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    // Per-IP limit for the Leasebot waitlist (POST /api/waitlist).
    { "name": "WAITLIST_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  // Leasebot waitlist (email, language, timestamp only). See DEPLOY-NOTES-waitlist.md.
  // Created Nov 23, 2026. If the binding is missing, POST /api/waitlist answers 503 and the page falls back to the email link.
  "d1_databases": [
    {
      "binding": "WAITLIST_DB",
      "database_name": "leasepath-waitlist",
      "database_id": "3a0ad610-4d1a-4823-95b4-9ab9a1c77b4b",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    { "tag": "v1-usage-meter", "new_sqlite_classes": ["UsageMeter"] },
    { "tag": "v2-account-book", "new_sqlite_classes": ["AccountBook"] }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
