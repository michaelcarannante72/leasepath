# Server-side only. Do not prefix this with VITE_.
# Create a key: https://console.x.ai/team/default/api-keys
# Local: copy this file to .env
# Production: npx wrangler secret put XAI_API_KEY
XAI_API_KEY=

# Web client id from Google Cloud Console. Not a secret.
# Origins: https://leasepath.app, https://www.leasepath.app, http://localhost:5183
# Production: npx wrangler secret put GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Signs the browser cookies that count free questions and keep a Google sign-in.
# Local dev creates .data/auth-secret when this is empty.
# Production: npx wrangler secret put LEASEPATH_AUTH_SECRET
LEASEPATH_AUTH_SECRET=
